+// Native adblock-rust Necko Interceptor FFI
+#include <mutex>
+#include <windows.h>
+
+typedef void (*FnShieldInit)(const char* cache_path);
+typedef bool (*FnShieldShouldBlock)(const char* url, const char* source_url, const char* request_type);
+static FnShieldShouldBlock sShieldShouldBlock = nullptr;
+static std::once_flag sShieldInitFlag;
+
+static void InitNeckoShieldOnce() {
+  std::call_once(sShieldInitFlag, []() {
+    HMODULE hMod = LoadLibraryExW(
+        L"necko_shield.dll", nullptr, LOAD_LIBRARY_SEARCH_APPLICATION_DIR);
+    if (hMod) {
+      auto fnInit = reinterpret_cast<FnShieldInit>(
+          GetProcAddress(hMod, "shield_load_or_compile_lists"));
+      if (fnInit) {
+        fnInit("necko_shield_engine.dat");
+      }
+      sShieldShouldBlock = reinterpret_cast<FnShieldShouldBlock>(
+          GetProcAddress(hMod, "shield_should_block"));
+    }
+  });
+}
+
+static bool CheckNeckoShield(const char* url, const char* source_url, const char* request_type) {
+  InitNeckoShieldOnce();
+  return sShieldShouldBlock ? sShieldShouldBlock(url, source_url, request_type) : false;
+}
