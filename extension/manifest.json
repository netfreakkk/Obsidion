{
  "manifest_version": 2,
  "name": "Obsidion Resource & VPN HUD",
  "version": "1.0",
  "description": "Live RAM & CPU Limiter, Tab Memory Purge, and Cloudflare WARP VPN Toggle for Obsidion",
  "browser_specific_settings": {
    "gecko": {
      "id": "obsidion-hud@obsidion.org",
      "strict_min_version": "100.0"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "64": "icon-64.png",
    "128": "icon-128.png",
    "256": "icon-256.png"
  },
  "browser_action": {
    "default_icon": {
      "48": "icon-48.png",
      "64": "icon-64.png"
    },
    "default_popup": "gx-resource-hud.html",
    "default_title": "Obsidion Core Hub"
  },
  "sidebar_action": {
    "default_icon": {
      "48": "icon-48.png"
    },
    "default_panel": "gx-resource-hud.html",
    "default_title": "Obsidion Core"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "tabs",
    "proxy",
    "storage",
    "alarms",
    "history",
    "topSites",
    "<all_urls>"
  ]
}
